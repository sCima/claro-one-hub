# ─────────────────────────────────────────────────────────────────────────────
# One Hub · variáveis de ambiente (copie para .env.local)
#
# Sem nenhuma variável definida o app roda em modo "mock": sessão, token e a
# NLU da Clara são simulados no browser. Preencha abaixo para plugar o backend
# real (Node.js/Express + Redis + Dialogflow) descrito no Documento de Arquitetura.
# ─────────────────────────────────────────────────────────────────────────────

# 'mock' (padrão) ou 'api'
NEXT_PUBLIC_BACKEND_MODE=mock

# Camada de aplicação e orquestração (Node.js + Express)
NEXT_PUBLIC_API_BASE_URL=

# Camada de sessão e contexto (Redis) — §4
NEXT_PUBLIC_SESSION_API_URL=
NEXT_PUBLIC_SESSION_TTL_SECONDS=1800

# Autenticação (JWT) — RNF005: expiração 30 min
NEXT_PUBLIC_AUTH_API_URL=
NEXT_PUBLIC_AUTH_TOKEN_TTL_SECONDS=1800

# Notificação proativa de incidentes técnicos (RF006)
NEXT_PUBLIC_INCIDENTS_API_URL=

# LGPD — consentimento e direito de exclusão (§7)
NEXT_PUBLIC_PRIVACY_API_URL=

# NLU da Clara — Dialogflow (§8). O front chama um proxy no backend,
# nunca o Dialogflow diretamente (não expõe credenciais no client).
NEXT_PUBLIC_DIALOGFLOW_ENABLED=false
NEXT_PUBLIC_DIALOGFLOW_DETECT_INTENT_URL=
NEXT_PUBLIC_DIALOGFLOW_PROJECT_ID=
NEXT_PUBLIC_DIALOGFLOW_LOCATION=global
